# E2E 설정 예시. 복사해서 .env.e2e로 쓴다(.env.e2e는 커밋하지 않는다).
# 대상은 로컬 도커 환경(e2e/infra)이다. 아래 값은 모두 선택이며, 비워 두면 로컬 기본값을 쓴다.

# FE 주소(로컬만 허용). 기본 http://localhost:5173
# E2E_BASE_URL=
# 고정 테스트 계정 공통 비밀번호(12자 이상). 기본값은 로컬 전용 값.
# E2E_PASSWORD=
# 서비스별 DB(호스트는 로컬만 허용). 기본값은 compose의 13306 · 13309.
# E2E_DB_MEMBER_URL=
# E2E_DB_PAYMENT_URL=

# 토스 테스트 키(test_ 로 시작하는 키만). BE 컨테이너(e2e:env:up)와 FE(NEXT_PUBLIC_*)가 읽는다.
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
