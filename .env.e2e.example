# E2E 설정 예시. 복사해서 .env.e2e로 쓴다(.env.e2e는 커밋하지 않는다).

# 테스트 대상 FE 주소(origin만). 반드시 E2E_ALLOWED_ORIGINS 안에 있어야 한다.
E2E_BASE_URL=
# 테스트해도 되는 origin 목록(쉼표로 구분). 여기 없는 주소면 멈춘다.
E2E_ALLOWED_ORIGINS=

# 고정 테스트 계정 5개의 공통 비밀번호(12자 이상). bootstrap이 해시해서 DB에 넣는다.
E2E_PASSWORD=

# bootstrap 전용(운영 DB에 쓴다). 서비스별 DB. 형식: mysql://user:password@host:port/db[?ssl=true]
E2E_DB_MEMBER_URL=
E2E_DB_PAYMENT_URL=

# 관리자 OTP 비밀키(Base32). 사람이 e2e-admin으로 한 번 로그인해 OTP를 등록한 뒤 화면의 비밀키를 적는다.
E2E_ADMIN_OTP_SECRET=
