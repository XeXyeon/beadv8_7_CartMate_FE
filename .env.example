# 환경변수 예시. 복사해서 .env.local로 쓴다(.env.local은 커밋하지 않는다).
# 주의: 아래 값은 `next build`와 `next start` 두 단계에 모두 줘야 한다.
#   - SITE_URL: robots.txt · 홈 · 검색 메타데이터가 빌드 때 정적으로 굳는다.
#   - 서비스 주소: rewrites가 빌드 때 굳고, 서버(RSC) 요청은 실행 중인 서버의 값을 읽는다(src/api/services.ts).

# 사이트 배포 주소 (canonical · Open Graph · sitemap 절대 URL).
# 비워 두면 robots.txt가 전체 색인을 막고 절대 URL을 내지 않는다(src/lib/seo.ts).
SITE_URL=

# BE 주소. 우선순위: <서비스>_SERVICE_URL > API_BASE_URL > http://localhost:<기본 포트>
# 게이트웨이가 생기면 API_BASE_URL 하나만 준다. 빈 값으로 두면 기본 주소 대신 빈 주소가 쓰이므로, 쓸 때만 주석을 푼다.
# API_BASE_URL=
# MEMBER_SERVICE_URL=
# PRODUCT_SERVICE_URL=
# PAYMENT_SERVICE_URL=
# ETC_SERVICE_URL=
# ORDER_SERVICE_URL=

# 상품 이미지 주소 접두어. 주석이면 /images (FE rewrite가 product 서비스로 넘긴다). 빈 값으로 두지 않는다.
# NEXT_PUBLIC_IMAGE_BASE_URL=

# 토스 API 개별 연동 키의 클라이언트 키(test_ck_...). 결제위젯 연동 키(test_gck_)는 결제창에서 쓸 수 없다.
# BE의 TOSS_SECRET_KEY와 같은 상점·같은 종류(test_sk_...)여야 한다.
# 빌드 때 굳으므로 값을 바꾸면 다시 빌드한다. 비워 두면 충전 화면이 설정 안내만 보여 준다.
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
